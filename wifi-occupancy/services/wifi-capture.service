[Unit]
Description=WiFi Probe Request Capture (tshark)
After=wifi-channel-hop.service
Requires=wifi-channel-hop.service

[Service]
Type=simple
ExecStartPre=/bin/mkdir -p /var/wifi-occupancy/data/raw
ExecStart=/var/wifi-occupancy/capture.sh
Restart=always
RestartSec=10
User=root
StandardOutput=append:/var/wifi-occupancy/logs/capture.log
StandardError=append:/var/wifi-occupancy/logs/capture.log

[Install]
WantedBy=multi-user.target
